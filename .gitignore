# Python bytecode caches, anywhere in the tree
__pycache__/
*.pyc
*.pyo

# scons state
.sconsign.dblite

# Build artifacts generated by scons (see SConstruct):
#  - SWIG-generated Python wrappers and interface/wrap files
#  - compiled shared libraries and the defwp binary/wrapper
src/cdefw_agent.py
src/cdefw_global.py
src/_c*.so
src/*.i
src/*_wrap.c
src/*.so
src/*.o
src/defwp
src/defwp-wrapper
src/defwd
